<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Jawab.Desktop.MainWindow"
        Title="jawab"
        Icon="avares://Jawab.Desktop/Assets/jawab.ico"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600"
        Background="#F8FAFC"
        FontFamily="Segoe UI, Tahoma, Arial">

  <Window.Styles>

    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#334155"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#64748B"/>
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#64748B"/>
    </Style>

    <Style Selector="Button">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="CornerRadius" Value="9"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0EA5E9"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="#0EA5E9"/>
    </Style>

    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#0284C7"/>
      <Setter Property="BorderBrush" Value="#0284C7"/>
    </Style>

    <Style Selector="Button.primary:pressed">
      <Setter Property="Background" Value="#0369A1"/>
      <Setter Property="BorderBrush" Value="#0369A1"/>
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="#D8E0EA"/>
    </Style>

    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="BorderBrush" Value="#94A3B8"/>
    </Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style Selector="Button.nav:pointerover">
      <Setter Property="Background" Value="#F1F5F9"/>
    </Style>

    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#E0F2FE"/>
      <Setter Property="Foreground" Value="#0369A1"/>
    </Style>

    <Style Selector="Button.header-action">
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="BorderBrush" Value="#D8E0EA"/>
    </Style>

    <Style Selector="Button.header-action:pointerover">
      <Setter Property="Background" Value="#F1F5F9"/>
    </Style>

    <Style Selector="TextBox.composer-input">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0"
            Padding="18,12"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0,0,0,1">

      <Grid ColumnDefinitions="Auto,*,Auto">

        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="42"
                  Height="42"
                  CornerRadius="11"
                  Background="White"
                  BorderBrush="#E5E7EB"
                  BorderThickness="1"
                  ClipToBounds="True">
            <Image Source="avares://Jawab.Desktop/Assets/jawab-logo.png"
                   Stretch="Uniform"
                   Margin="3"/>
          </Border>

          <StackPanel Spacing="1" VerticalAlignment="Center">
            <TextBlock Text="jawab"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"/>
            <TextBlock x:Name="HeaderSubtitle"
                       Text="Local evidence search"
                       Classes="muted"
                       FontSize="12"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">

          <Button x:Name="ImportButton"
                  Classes="primary"
                  Content="Import files"
                  MinWidth="128"
                  MinHeight="42"
                  Click="ImportButton_Click"
                  ToolTip.Tip="Import TXT or Markdown files"/>

          <Button x:Name="LanguageButton"
                  Classes="header-action"
                  Content="Language ▾"
                  MinWidth="112"
                  Click="LanguageButton_Click"
                  ToolTip.Tip="Choose interface language"/>

          <Button Classes="header-action"
                  Content="About"
                  Click="AboutButton_Click"
                  ToolTip.Tip="About Jawab"/>

          <Button Classes="header-action"
                  Content="Settings"
                  Click="SettingsButton_Click"
                  ToolTip.Tip="Application settings"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="252,*">

      <Border Grid.Column="0"
              Background="White"
              BorderBrush="#E5E7EB"
              BorderThickness="0,0,1,0">

        <ScrollViewer>
          <StackPanel Margin="16" Spacing="8">

            <TextBlock x:Name="KnowledgeBasesLabel"
                       Text="Knowledge bases"
                       Classes="label"
                       Margin="8,4,8,4"/>

            <Button x:Name="AllDataButton"
                    Classes="nav"
                    Content="All local data"/>

            <Button x:Name="TechnicalButton"
                    Classes="nav selected"
                    Content="Technical corpus"/>

            <Button x:Name="NotesButton"
                    Classes="nav"
                    Content="My notes"/>

            <Separator Margin="0,10"/>

            <Button x:Name="NewKnowledgeButton"
                    Classes="nav"
                    Content="New knowledge base"
                    Click="ImportButton_Click"/>

            <TextBlock x:Name="StatusLabel"
                       Text="Status"
                       Classes="label"
                       Margin="8,16,8,4"/>

            <Border Padding="11"
                    CornerRadius="9"
                    Background="#F8FAFC"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1">
              <StackPanel Spacing="5">
                <TextBlock x:Name="IndexStatusText"
                           Text="No imported files"
                           Classes="muted"
                           FontSize="13"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto">

        <ScrollViewer x:Name="ConversationScroll"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Background="#F8FAFC">

          <StackPanel x:Name="ConversationPanel"
                      MaxWidth="960"
                      Margin="48,38,48,32"
                      HorizontalAlignment="Center"
                      Spacing="20">

            <StackPanel Spacing="8">
              <TextBlock x:Name="PageTitle"
                         Text="Ask your knowledge"
                         Classes="page-title"/>

              <TextBlock x:Name="PageDescription"
                         Text="Search imported files and inspect the evidence behind every result."
                         Classes="body"
                         Foreground="#64748B"/>
            </StackPanel>

            <Border Background="#EFF6FF"
                    Padding="16"
                    CornerRadius="12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="i"
                           FontWeight="Bold"
                           Foreground="#0284C7"/>
                <TextBlock x:Name="WelcomeNoteText"
                           Text="Import a TXT or Markdown file to begin."
                           Classes="muted"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="#F8FAFC"
                BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0"
                Padding="24,18">

          <Border MaxWidth="980"
                  Height="76"
                  HorizontalAlignment="Center"
                  Background="#FFFFFF"
                  BorderBrush="#CBD5E1"
                  BorderThickness="1"
                  CornerRadius="18"
                  Padding="6">

            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="8">

              <TextBox x:Name="QuestionBox"
                       Grid.Column="0"
                       Classes="composer-input"
                       Height="60"
                       MinHeight="60"
                       MaxHeight="60"
                       AcceptsReturn="False"
                       TextWrapping="NoWrap"
                       VerticalContentAlignment="Center"
                       PlaceholderText="Ask a question…"
                       KeyDown="QuestionBox_KeyDown"
                       TextChanged="QuestionBox_TextChanged"/>

              <Button x:Name="SaveNoteButton"
                      Grid.Column="1"
                      Classes="secondary"
                      Width="56"
                      Height="56"
                      MinHeight="56"
                      Padding="0"
                      FontSize="18"
                      Content="⌑"
                      Click="SaveNoteButton_Click"
                      ToolTip.Tip="Save as note"/>

              <Button x:Name="SendButton"
                      Grid.Column="2"
                      Classes="primary"
                      Width="56"
                      Height="56"
                      MinHeight="56"
                      Padding="0"
                      FontSize="20"
                      FontWeight="SemiBold"
                      Content="➤"
                      Click="SendButton_Click"
                      ToolTip.Tip="Send message"/>
            </Grid>
          </Border>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>










